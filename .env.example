# ─── Server ───────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/leadsetu
DATABASE_URL=postgresql://postgres:dev_password@localhost:5432/leadsetu_dev

# ─── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────
JWT_SECRET=change_me_to_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Internal Service Communication ───────────────
# This secret is sent as a header when calling leadsetu-ai
LEADSETU_AI_URL=http://localhost:3002
LEADSETU_AI_INTERNAL_SECRET=change_me_same_as_ai_side

# ─── WhatsApp Business Platform ───────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Email Provider (e.g. Postmark) ───────────────
EMAIL_PROVIDER=postmark
EMAIL_API_KEY=
EMAIL_FROM=noreply@leadsetu.in

# ─── Payments ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Storage ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=leadsetu-dev
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Frontend (for CORS) ──────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Native WebRTC Voice Calling (Optional TURN) ──
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600
TURN_USERNAME=
TURN_CREDENTIAL=
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
ICE_FORCE_TURN=false
